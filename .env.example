# Database
DATABASE_URL=postgres://broth:broth@localhost:5432/broth_dev?sslmode=disable
PSQL_DSN=postgres://broth:broth@localhost:5432/broth_dev?sslmode=disable

# Server
APP_ADDR=:8080
